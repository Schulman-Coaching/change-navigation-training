---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
---

<BaseLayout
  title={`Privacy Policy — ${SITE.name}`}
  description={`How ${SITE.name} collects, uses, and protects your information.`}
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>Privacy Policy</h1>
        <p>Last updated: May 26, 2026</p>
      </div>
    </section>

    <section class="section">
      <div class="container legal-content">
        <h2>1. What We Collect</h2>
        <p>When you use our website, subscribe to our email list, book a call, or register for a workshop, we may collect:</p>
        <ul>
          <li>Your name and email address (when you subscribe, book, or register)</li>
          <li>Information you provide through our contact form</li>
          <li>Assessment responses (when you take our Change Readiness Self-Assessment)</li>
          <li>Payment information (processed securely by Stripe — we do not store card details)</li>
          <li>Standard web analytics data (pages visited, time on site) via our analytics provider</li>
        </ul>

        <h2>2. How We Use It</h2>
        <p>We use your information to:</p>
        <ul>
          <li>Send you the emails you signed up for (blog updates, workshop announcements)</li>
          <li>Process workshop and membership registrations</li>
          <li>Respond to your inquiries</li>
          <li>Improve our content and services</li>
        </ul>
        <p>We do not sell, rent, or share your personal information with third parties for their marketing purposes.</p>

        <h2>3. Email Communications</h2>
        <p>You will only receive emails from us if you explicitly subscribe or register. Every email includes an unsubscribe link. You can opt out at any time.</p>

        <h2>4. Payment Processing</h2>
        <p>All payments are processed through Stripe. We do not collect or store your credit card information on our servers. Stripe's privacy policy applies to payment data.</p>

        <h2>5. Cookies</h2>
        <p>Our site uses minimal cookies for essential functions (like form submissions) and optional analytics. You can disable cookies in your browser settings.</p>

        <h2>6. Data Retention</h2>
        <p>We retain your information only as long as needed to provide our services or as required by law. You may request deletion of your data at any time by contacting us.</p>

        <h2>7. Your Rights</h2>
        <p>You have the right to:</p>
        <ul>
          <li>Access the personal data we hold about you</li>
          <li>Request correction or deletion of your data</li>
          <li>Withdraw consent for email communications</li>
          <li>Request a copy of your data in a portable format</li>
        </ul>

        <h2>8. Contact</h2>
        <p>For privacy-related questions or requests, contact us at:</p>
        <p><strong>Email:</strong> elie@cohortlearninglabs.org</p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(135deg, var(--color-black), #1a1410); padding: 5rem 1.5rem 3rem; text-align: center; border-bottom: 3px solid var(--color-gold); }
  .page-hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.5rem; }
  .page-hero p { color: var(--color-gray-light); font-size: 0.9rem; }
  .legal-content { max-width: 700px; margin: 0 auto; }
  .legal-content h2 { font-size: 1.4rem; color: var(--color-gold); margin: 2rem 0 0.75rem; }
  .legal-content h2:first-child { margin-top: 0; }
  .legal-content p, .legal-content li { color: var(--color-gray-light); font-size: 0.95rem; line-height: 1.7; margin-bottom: 0.75rem; }
  .legal-content ul { padding-left: 1.5rem; margin-bottom: 1rem; }
</style>
