---
// Stripe Payment Link Button
// Uses Stripe Payment Links — no monthly SaaS cost, just transaction fees.
//
// Setup:
// 1. Create a Stripe account at dashboard.stripe.com
// 2. Go to Payments → Payment Links → Create payment link
// 3. Set the price, description, and optionally recurring billing
// 4. Copy the generated link (looks like https://buy.stripe.com/...)
// 5. Pass it as the `href` prop
//
// Usage:
//   <StripeButton href="https://buy.stripe.com/abc123" text="Join Now — $89/mo" />
//   <StripeButton href="https://buy.stripe.com/abc123" text="Enroll — $349" variant="outline" />

export interface Props {
  href: string;
  text?: string;
  variant?: 'primary' | 'outline';
  /** Used when href is not a live https Payment Link (for example the TODO pilot link). */
  pendingHref?: string;
}

const {
  href,
  text = 'Pay Now',
  variant = 'primary',
  pendingHref = '/contact/?interest=pilot',
} = Astro.props;

const classNames = variant === 'outline' ? 'btn btn-outline' : 'btn';
const payable = typeof href === 'string' && href.startsWith('https://');
---

{payable ? (
  <a href={href} class={classNames} target="_blank" rel="noopener">
    {text}
  </a>
) : (
  <span class="stripe-pending">
    <a href={pendingHref} class={classNames}>{text}</a>
    <p class="stripe-pending-note">TODO: the Stripe Payment Link is not connected yet. This opens the contact form.</p>
  </span>
)}

<style>
  .stripe-pending {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 360px;
  }

  .stripe-pending-note {
    font-size: 0.8rem;
    color: var(--color-gray-light);
    line-height: 1.4;
  }
</style>
