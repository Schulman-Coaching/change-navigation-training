---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';
import CalendlyWidget from '../components/CalendlyWidget.astro';
import { CALENDLY_LINKS } from '../config';
---

<BaseLayout
  title="Contact — Change Navigation Training"
  description="Get in touch with Change Navigation Training. Book a workshop, ask about memberships, or inquire about private coaching and organizational training."
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>Contact Us</h1>
        <p>We'd love to hear from you. Ask a question, book a workshop, or start a conversation.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-info">
            <h2>Get in Touch</h2>

            <div class="contact-methods">
              <h3>Email</h3>
              <p><a href="mailto:elie@cohortlearninglabs.org">elie@cohortlearninglabs.org</a></p>
            </div>

            <div class="contact-methods">
              <h3>Get Started</h3>
              <div class="social-links">
                <a href="/assessment/">Take the Free Assessment</a>
              </div>
            </div>
          </div>

          <div class="contact-form">
            <h2>Send Us a Message</h2>
            <form id="contact-form" class="form">
              <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" required />
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
              </div>
              <div class="form-group">
                <label for="phone">Phone (optional)</label>
                <input type="tel" id="phone" name="phone" />
              </div>
              <div class="form-group">
                <label for="interest">I'm interested in</label>
                <select id="interest" name="interest">
                  <option value="">Select an option</option>
                  <option value="workshop">Booking a workshop</option>
                  <option value="membership">Membership information</option>
                  <option value="womens">AI Confidence program</option>
                  <option value="community">Joining a peer circle</option>
                  <option value="private">Private coaching</option>
                  <option value="organizational">Organizational training</option>
                  <option value="call">A free consultation</option>
                  <option value="coaching">A coaching discovery call</option>
                  <option value="pilot">The founding pilot cohort</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="5"></textarea>
              </div>
              <button type="submit" class="btn" id="submit-btn">Send Message</button>
              <div id="form-message" style="margin-top:1rem;font-size:0.9rem;"></div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--color-dark);">
      <div class="container text-center">
        <h2>Schedule a Call</h2>
        <p style="color: var(--color-gray-light); margin: 1rem 0 2rem;">Prefer to talk? Book a free 20-minute consultation directly.</p>
        <CalendlyWidget url={CALENDLY_LINKS.consultation} height="600px" />
      </div>
    </section>
  </main>

  <CTABanner />
  <Footer />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-black), #1a1410);
    padding: 5rem 1.5rem 3rem;
    text-align: center;
    border-bottom: 3px solid var(--color-gold);
  }
  .page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 0.5rem; }
  .page-hero p { color: var(--color-gray-light); font-size: 1.1rem; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .contact-info h2 { margin-bottom: 2rem; }

  .contact-methods { margin-bottom: 2rem; }
  .contact-methods h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .contact-methods p { color: var(--color-gray-light); }
  .contact-methods a { color: var(--color-gold); }

  .social-links { margin-top: 1rem; }
  .social-links a {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-gray-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .social-links a:hover { color: var(--color-gold); }

  .contact-form h2 { margin-bottom: 2rem; }

  .form { display: flex; flex-direction: column; gap: 1.25rem; }

  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray-light);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: var(--color-dark);
    border: 1px solid var(--color-gray);
    padding: 0.75rem 1rem;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .form-group select option { background: var(--color-dark); color: var(--color-white); }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  #form-message.success { color: #3ec870; }
  #form-message.error { color: #c83e6b; }
</style>

<script>
  const interestPresets = {
    call: 'I would like a free consultation. A time that works for me: ',
    coaching: 'I would like a coaching discovery call. A time that works for me: ',
    pilot: 'I want a seat in the founding pilot (Tuesdays Nov 10, 17, 24, and Dec 1, 2026). ',
  };
  const params = new URLSearchParams(window.location.search);
  const interestParam = params.get('interest');
  const interestField = document.getElementById('interest');
  const messageField = document.getElementById('message');
  if (interestParam && interestField instanceof HTMLSelectElement) {
    const match = [...interestField.options].some((option) => option.value === interestParam);
    if (match) interestField.value = interestParam;
  }
  if (interestParam && messageField instanceof HTMLTextAreaElement && !messageField.value && interestPresets[interestParam]) {
    messageField.value = interestPresets[interestParam];
  }

  document.getElementById('contact-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    const msg = document.getElementById('form-message');
    btn.textContent = 'Sending...';
    btn.disabled = true;
    msg.className = '';
    msg.textContent = '';

    const data = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      message: `[Interest: ${document.getElementById('interest').value || 'Not specified'}]\n\n${document.getElementById('message').value}`,
      site: 'CNT: Lead',
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (result.success) {
        msg.className = 'success';
        msg.textContent = result.message;
        document.getElementById('contact-form').reset();
      } else {
        msg.className = 'error';
        msg.textContent = result.error || 'Something went wrong.';
      }
    } catch (err) {
      msg.className = 'error';
      msg.textContent = 'Network error. Please try again or email us directly.';
    }
    btn.textContent = 'Send Message';
    btn.disabled = false;
  });
</script>
