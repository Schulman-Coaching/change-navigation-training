---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';
import CalendlyWidget from '../components/CalendlyWidget.astro';
import { CALENDLY_LINKS } from '../config';
---

<BaseLayout
  title="Referral Program — Change Navigation Training"
  description="Earn $50 credit for every person you refer to Change Navigation Training. Share our workshops and memberships with people you know."
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container text-center">
        <h1>Share What Matters</h1>
        <p>The best way in is through someone who has already been here. When you refer someone to our workshops or memberships, you both benefit.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="referral-grid">
          <div class="referral-card">
            <h3>$50 Credit</h3>
            <p class="referral-amount">For You</p>
            <p>For every person you refer who joins a membership, you receive a $50 credit toward your own membership, workshop, or coaching session.</p>
          </div>
          <div class="referral-card">
            <h3>$20 Off</h3>
            <p class="referral-amount">For Them</p>
            <p>The person you refer gets $20 off their first workshop. They start with a discount. Everyone wins.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--color-dark);">
      <div class="container text-center">
        <h2>How It Works</h2>
        <div class="steps-grid">
          <div class="step">
            <div class="step-number">1</div>
            <h4>Get Your Link</h4>
            <p>Book a quick call below. We'll set you up with a unique referral link and Stripe coupon code.</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <h4>Share It</h4>
            <p>Send your link to people you know — WhatsApp, email, in person. No scripts. Just share what you know.</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <h4>Earn Credit</h4>
            <p>When someone joins through your link, the credit is automatically applied to your account. Track your referrals anytime.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="text-center">Referral Tiers</h2>
        <div class="tiers-grid">
          <div class="tier">
            <h4>1 Referral</h4>
            <p>$50 credit</p>
          </div>
          <div class="tier">
            <h4>3 Referrals</h4>
            <p>$150 credit + free workshop</p>
          </div>
          <div class="tier">
            <h4>5 Referrals</h4>
            <p>$250 credit + free month of membership</p>
          </div>
          <div class="tier tier-featured">
            <h4>10 Referrals</h4>
            <p>$500 credit + 6 months free membership</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--color-dark);">
      <div class="container text-center">
        <h2>Get Your Referral Link</h2>
        <p style="color: var(--color-gray-light); margin: 1rem 0 2rem;">Book a 10-minute call. We'll set up your unique referral link and answer any questions.</p>
        <CalendlyWidget url={CALENDLY_LINKS.consultation} height="600px" />
      </div>
    </section>

    <section class="section text-center">
      <div class="container">
        <h2>Tracking Dashboard</h2>
        <p style="color: var(--color-gray-light); margin: 1rem 0 2rem;">Already a referrer? Your personalized dashboard shows every referral, status, and credit balance.</p>
        <div class="tracking-placeholder">
          <p class="tracking-title">Referral Dashboard</p>
          <p class="tracking-text">Enter your referral code to view your dashboard.</p>
          <form class="tracking-form" id="tracking-form">
            <input type="text" placeholder="Your referral code" id="ref-code" style="background:var(--color-dark);border:1px solid var(--color-gray);padding:0.75rem 1rem;color:var(--color-white);font-size:0.9rem;width:280px;" />
            <button type="submit" class="btn" style="padding:0.75rem 1.5rem;">View Dashboard</button>
          </form>
          <p id="tracking-msg" style="margin-top:1rem;font-size:0.85rem;"></p>
        </div>
      </div>
    </section>
  </main>

  <CTABanner />
  <Footer />
</BaseLayout>

<script>
  document.getElementById('tracking-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = document.getElementById('ref-code').value.trim();
    const msg = document.getElementById('tracking-msg');
    if (!code) {
      msg.textContent = 'Please enter your referral code.';
      msg.style.color = '#c83e6b';
      return;
    }
    msg.textContent = 'Looking up...';
    msg.style.color = '#777777';
    try {
      const res = await fetch('/api/referral?code=' + encodeURIComponent(code));
      const data = await res.json();
      if (data.success) {
        msg.innerHTML = `<strong>${data.name}</strong><br>Referrals: ${data.count}<br>Credit balance: $${data.credit}<br>Recent: ${data.recent || 'None yet'}`;
        msg.style.color = '#3ec870';
      } else {
        msg.textContent = data.error || 'Referral code not found.';
        msg.style.color = '#c83e6b';
      }
    } catch {
      msg.textContent = 'Dashboard unavailable. Contact us for your status.';
      msg.style.color = '#c83e6b';
    }
  });
</script>

<style>
  .page-hero { background: linear-gradient(135deg, var(--color-black), #1a1410); padding: 5rem 1.5rem 3rem; text-align: center; border-bottom: 3px solid var(--color-gold); }
  .page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 0.5rem; }
  .page-hero p { color: var(--color-gray-light); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .referral-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .referral-card { background: var(--color-dark); border: 1px solid var(--color-gray); padding: 2.5rem 2rem; text-align: center; }
  .referral-card:first-child { border-color: var(--color-gold); }
  .referral-card h3 { font-size: 2.5rem; color: var(--color-gold); margin-bottom: 0.25rem; }
  .referral-amount { color: var(--color-gray-light); font-size: 1rem; margin-bottom: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .referral-card p { color: var(--color-gray-light); font-size: 0.9rem; }

  .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2rem; }
  .step { text-align: center; }
  .step-number { width: 48px; height: 48px; border: 2px solid var(--color-gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-family: var(--font-display); font-size: 1.5rem; color: var(--color-gold); }
  .step h4 { margin-bottom: 0.5rem; }
  .step p { color: var(--color-gray-light); font-size: 0.85rem; }

  .tiers-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; }
  .tier { background: var(--color-dark); border: 1px solid var(--color-gray); padding: 1.5rem 1rem; text-align: center; }
  .tier-featured { border-color: var(--color-gold); }
  .tier h4 { margin-bottom: 0.5rem; color: var(--color-gold); }
  .tier p { color: var(--color-gray-light); font-size: 0.85rem; }

  .tracking-placeholder { background: var(--color-dark); border: 1px solid var(--color-gray); padding: 2.5rem 2rem; max-width: 500px; margin: 0 auto; }
  .tracking-title { font-family: var(--font-display); font-size: 1.3rem; color: var(--color-gold); margin-bottom: 0.5rem; }
  .tracking-text { color: var(--color-gray-light); margin-bottom: 1.5rem; font-size: 0.9rem; }
  .tracking-form { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 768px) {
    .referral-grid, .steps-grid { grid-template-columns: 1fr; }
    .tiers-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
