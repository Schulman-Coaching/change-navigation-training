---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';
import { SEGMENTS } from '../config';
import { getCollection } from 'astro:content';

// Get a featured blog post for each segment
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function getFeaturedPost(audience: string) {
  return sortedPosts.find(p => p.data.audience === audience) || sortedPosts[0];
}
---

<BaseLayout
  title="Change Navigation Training — Navigate AI Change With Confidence"
  description="AI training and change-navigation workshops for Orthodox Jewish women. Build confidence, master AI tools, and navigate change — at every stage of life. Workshops, coaching, and community."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-content container">
        <h1 class="hero-title">
          Navigate Change<br/>
          <span class="text-gold">With Confidence</span>
        </h1>
        <p class="hero-subtitle">
          AI isn't the disruption. Your response to it is. Practical skills for Orthodox Jewish women
          who want to move forward with clarity, not fear.
        </p>
        <div class="hero-actions">
          <a href="/assessment/" class="btn">Take Free Assessment</a>
          <a href="/group-workshops/" class="btn btn-outline">View Workshops</a>
          <a href="/memberships/" class="btn btn-outline">See Memberships</a>
        </div>
      </div>
    </section>

    <!-- Mission -->
    <section class="mission section">
      <div class="container">
        <div class="mission-grid">
          <div class="mission-text">
            <h2>Our Mission</h2>
            <p class="mission-lead">
              We help Orthodox Jewish women build the skills to navigate change — personal,
              professional, and technological — with confidence and clarity.
            </p>
            <p>
              Change is not a disruption to manage. It is a skill to develop. Our training goes
              beyond learning AI tools. It is about cultivating the mindset to see change clearly,
              respond thoughtfully, and move forward with agency.
            </p>
            <div class="mission-stats">
              <div class="stat">
                <span class="stat-number">14</span>
                <span class="stat-label">Workshop Modules</span>
              </div>
              <div class="stat">
                <span class="stat-number">6</span>
                <span class="stat-label">Peer Circles</span>
              </div>
              <div class="stat">
                <span class="stat-number">Free</span>
                <span class="stat-label">First Call</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Audience Segments -->
    <section class="segments section">
      <div class="container">
        <h2 class="text-center">A Path for Every Woman</h2>
        <p class="segments-subtitle text-center">Wherever you are in life, there is a room here for you.</p>
        <div class="segments-grid">
          {SEGMENTS.map((seg) => {
            const post = getFeaturedPost(seg.id);
            return (
              <div class="segment-card" style={`--seg-accent: ${seg.accent};`}>
                <div class="segment-header">
                  <span class="segment-age">{seg.age}</span>
                  <h3>{seg.name}</h3>
                </div>
                <p class="segment-tagline">{seg.tagline}</p>
                <p class="segment-message">{seg.message}</p>
                <p class="segment-emotion">{seg.emotion}</p>
                <div class="segment-cta">
                  <a href="/assessment/" class="btn btn-sm" style={`border-color: ${seg.accent}; background: ${seg.accent};`}>Take the Assessment</a>
                  {post && <a href={`/blog/${post.data.slug}/`} class="segment-blog-link">Read: {post.data.title}</a>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Training Philosophy -->
    <section class="philosophy section">
      <div class="container text-center">
        <h2>Our Approach</h2>
        <p class="philosophy-lead">
          Change is uncomfortable. That is not a problem to solve. It is the signal that growth is happening.
        </p>
        <div class="philosophy-grid">
          <div class="philosophy-item">
            <h3>Facilitated, Not Lectured</h3>
            <p>The room does the work. The facilitator creates the conditions. Learning comes from participation, not from the front of the room.</p>
          </div>
          <div class="philosophy-item">
            <h3>Context First</h3>
            <p>Shabbos-aware scheduling. Women-only spaces. Values-aligned content. Training built in your context from the start.</p>
          </div>
          <div class="philosophy-item">
            <h3>Discomfort Is the Signal</h3>
            <p>Learning anything new is uncomfortable. That is not a sign you are in the wrong place. It is the signal that growth is happening.</p>
          </div>
          <div class="philosophy-item">
            <h3>Community Is the Mechanism</h3>
            <p>The question that stumps you at 10 PM is the same question three other women had that week. In a room together, someone asks out loud.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Programs -->
    <section class="programs section">
      <div class="container">
        <h2 class="text-center">Our Programs</h2>
        <p class="programs-subtitle text-center">A path for every woman</p>
        <div class="programs-grid">
          <a href="/group-workshops/" class="program-card">
            <h3 class="font-display">Group Workshops</h3>
            <p>Hands-on sessions. AI tools, change frameworks, and practical skills in a supportive group setting.</p>
          </a>
          <a href="/womens-ai-confidence/" class="program-card">
            <h3 class="font-display">Women's AI Confidence</h3>
            <p>Our flagship program. Build AI literacy and change-navigation skills over 8 weeks.</p>
          </a>
          <a href="/community/" class="program-card">
            <h3 class="font-display">Peer Learning Circles</h3>
            <p>Small groups of women learning together. Monthly topics, shared accountability, real support.</p>
          </a>
          <a href="/organizational-training/" class="program-card">
            <h3 class="font-display">Organizational Training</h3>
            <p>For schools, nonprofits, and businesses. Help your team or community navigate AI change together.</p>
          </a>
          <a href="/private-coaching/" class="program-card">
            <h3 class="font-display">Private Coaching</h3>
            <p>One-on-one sessions. Personalized guidance for your specific change journey.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Blog Preview -->
    <section class="blog-preview section" style="background: var(--color-dark);">
      <div class="container">
        <div class="blog-preview-header">
          <h2>From the Blog</h2>
          <p class="blog-preview-subtitle">Latest thinking on change, AI, and what it means for you</p>
        </div>
        <div class="blog-preview-grid">
          {sortedPosts.slice(0, 3).map((post) => (
            <a href={`/blog/${post.data.slug}/`} class="blog-preview-card">
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
              <span class="blog-preview-link">Read More →</span>
            </a>
          ))}
        </div>
        <div class="text-center">
          <a href="/blog/" class="btn btn-outline">Read the Blog</a>
        </div>
      </div>
    </section>

    <!-- Membership Preview -->
    <section class="section">
      <div class="container text-center">
        <h2>Our Memberships</h2>
        <p class="programs-subtitle">Flexible options for every journey</p>
        <div class="pricing-row">
          <div class="pricing-card">
            <h3>Monthly Explorer</h3>
            <p class="pricing-amount">$89<span>/mo</span></p>
            <p class="pricing-note">All workshops. Peer circle access. Resource library.</p>
          </div>
          <div class="pricing-card pricing-card--featured">
            <h3>Annual Navigator</h3>
            <p class="pricing-amount">$69<span>/mo</span></p>
            <p class="pricing-note">Best value. Paid once annually. Priority coaching access.</p>
          </div>
          <div class="pricing-card">
            <h3>6-Month Journey</h3>
            <p class="pricing-amount">$79<span>/mo</span></p>
            <p class="pricing-note">All workshops. All peer circles. Resource library.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <CTABanner />
  <Footer />
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1410 50%, #0d0a05 100%);
    padding: 6rem 1.5rem 5rem;
    text-align: center;
    border-bottom: 3px solid var(--color-gold);
  }

  .hero-content { max-width: 800px; }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    margin-bottom: 1.5rem;
    line-height: 1;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-gray-light);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .mission { text-align: center; }
  .mission-grid { max-width: 700px; margin: 0 auto; }

  .mission-lead {
    font-size: 1.2rem;
    color: var(--color-white);
    margin: 1rem 0;
  }

  .mission p {
    color: var(--color-gray-light);
    font-size: 1.05rem;
  }

  .mission-stats {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .stat { text-align: center; }

  .stat-number {
    display: block;
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-gold);
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-light);
    margin-top: 0.25rem;
  }

  /* Audience Segments */
  .segments { background: var(--color-dark); }
  .segments-subtitle { color: var(--color-gray-light); margin-bottom: 3rem; }

  .segments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .segment-card {
    background: var(--color-black);
    border: 1px solid var(--color-gray);
    border-top: 3px solid var(--seg-accent);
    padding: 2rem;
    transition: border-color 0.2s;
  }

  .segment-card:hover { border-color: var(--seg-accent); }

  .segment-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .segment-age {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--seg-accent);
    font-weight: 600;
  }

  .segment-card h3 {
    font-size: 1.3rem;
    color: var(--color-white);
    margin: 0;
  }

  .segment-tagline {
    font-size: 0.9rem;
    color: var(--color-gray-light);
    margin-bottom: 0.5rem;
    font-style: italic;
  }

  .segment-message {
    font-size: 1rem;
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .segment-emotion {
    font-size: 0.75rem;
    color: var(--seg-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }

  .segment-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .segment-blog-link {
    font-size: 0.85rem;
    color: var(--color-gray-light);
    text-decoration: underline;
    text-decoration-color: var(--seg-accent);
  }

  .segment-blog-link:hover { color: var(--color-white); }

  .btn-sm {
    padding: 0.6rem 1.25rem;
    font-size: 0.85rem;
  }

  /* Philosophy */
  .philosophy-lead {
    font-size: 1.2rem;
    color: var(--color-gray-light);
    max-width: 600px;
    margin: 0 auto 3rem;
    font-style: italic;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .philosophy-item {
    background: var(--color-dark);
    border: 1px solid var(--color-gray);
    padding: 2rem;
    text-align: left;
  }

  .philosophy-item h3 { font-size: 1.1rem; margin-bottom: 0.75rem; color: var(--color-gold); }
  .philosophy-item p { font-size: 0.85rem; color: var(--color-gray-light); line-height: 1.5; }

  /* Programs */
  .programs { text-align: center; }
  .programs-subtitle { color: var(--color-gray-light); margin-bottom: 2.5rem; }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .program-card {
    background: var(--color-dark);
    border: 1px solid var(--color-gray);
    padding: 2rem;
    text-align: left;
    transition: border-color 0.2s;
  }

  .program-card:hover { border-color: var(--color-gold); }
  .program-card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; color: var(--color-gold); }
  .program-card p { font-size: 0.85rem; color: var(--color-gray-light); line-height: 1.5; }

  /* Blog Preview */
  .blog-preview { text-align: center; }
  .blog-preview-header { margin-bottom: 2rem; }
  .blog-preview-subtitle { color: var(--color-gray-light); margin-top: 0.5rem; }

  .blog-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .blog-preview-card {
    background: var(--color-black);
    border: 1px solid var(--color-gray);
    padding: 2rem;
    transition: border-color 0.2s;
  }

  .blog-preview-card:hover { border-color: var(--color-gold); }

  .blog-preview-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
    color: var(--color-gold);
  }

  .blog-preview-card p {
    font-size: 0.85rem;
    color: var(--color-gray-light);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .blog-preview-link {
    font-size: 0.8rem;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Pricing */
  .pricing-row {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .pricing-card {
    background: var(--color-dark);
    border: 1px solid var(--color-gray);
    padding: 2rem;
    min-width: 240px;
    max-width: 300px;
    text-align: center;
  }

  .pricing-card--featured { border-color: var(--color-gold); }

  .pricing-card h3 { font-size: 1.2rem; margin-bottom: 0.75rem; }

  .pricing-amount {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .pricing-amount span {
    font-size: 1rem;
    color: var(--color-gray-light);
    font-family: var(--font-body);
  }

  .pricing-note {
    font-size: 0.85rem;
    color: var(--color-gray-light);
  }

  @media (max-width: 768px) {
    .hero { padding: 4rem 1.5rem 3rem; }
    .blog-preview-grid { grid-template-columns: 1fr; }
  }
</style>
