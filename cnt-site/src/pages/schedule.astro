---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';
import CalendlyWidget from '../components/CalendlyWidget.astro';
import { CALENDLY_LINKS } from '../config';

const allWorkshops = await getCollection('workshops');

// Sort by start date
const sorted = allWorkshops.sort((a, b) => {
  const da = new Date(a.data.startDate).getTime();
  const db = new Date(b.data.startDate).getTime();
  return da - db;
});

const septemberWorkshops = sorted.filter((w) => w.data.cohort === 'September 2026');

const levelLabels: Record<string, string> = {
  'beginner': 'Beginner',
  'intermediate': 'Intermediate',
  'all-levels': 'All Levels',
};

const categoryLabels: Record<string, string> = {
  'ai-literacy': 'AI Literacy',
  'change-navigation': 'Change Navigation',
  'practical-tools': 'Practical Tools',
  'career': 'Career',
  'education': 'Education',
};
---

<BaseLayout
  title="Upcoming Classes & Workshops — Change Navigation Training"
  description="View our upcoming workshops for September 2026. AI literacy, change navigation, career development, and more. Designed for Orthodox Jewish women."
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>Upcoming Classes</h1>
        <p>Fall 2026. Workshops across September. Every session designed for women who want to move forward with clarity.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="schedule-note">
          <p>All workshops are live, online, and designed for Orthodox Jewish women. Scheduling respects Shabbat and Yom Tov. No sessions on Friday evening or Saturday.</p>
        </div>

        <!-- September 2026 -->
        <h2 class="month-heading">September 2026</h2>
        <div class="workshop-grid">
          {septemberWorkshops.map((w) => {
            const { data } = w;
            const startDate = new Date(data.startDate);
            const startStr = startDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
            return (
              <div class="workshop-card">
                <div class="card-header">
                  <span class={`level-badge level--${data.level}`}>{levelLabels[data.level]}</span>
                  <span class="category-badge">{categoryLabels[data.category]}</span>
                </div>
                <h3><a href={`/workshops/${data.slug}/`}>{data.title}</a></h3>
                <p class="excerpt">{data.excerpt}</p>
                <div class="card-details">
                  <div class="detail">
                    <span class="detail-label">Starts</span>
                    <span class="detail-value">{startStr}</span>
                  </div>
                  <div class="detail">
                    <span class="detail-label">When</span>
                    <span class="detail-value">{data.dayOfWeek}, {data.time} {data.timezone}</span>
                  </div>
                  <div class="detail">
                    <span class="detail-label">Format</span>
                    <span class="detail-value">{data.sessions} sessions &middot; {data.duration}</span>
                  </div>
                  <div class="detail">
                    <span class="detail-label">Price</span>
                    <span class="detail-value detail-price">{data.price}</span>
                  </div>
                </div>
                <div class="card-actions">
                  <a href={`/workshops/${data.slug}/`} class="btn btn-sm">View Details</a>
                  <a href="/contact/" class="btn btn-outline btn-sm">Register</a>
                </div>
              </div>
            );
          })}
        </div>

        <div class="schedule-cta text-center">
          <h2>Ready to Join a Workshop?</h2>
          <p>First session is $35. See what it feels like to learn alongside women who get it.</p>
          <div class="cta-buttons">
            <a href="/contact/" class="btn">Register Now</a>
            <a href="/contact/" class="btn btn-outline">Ask a Question</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--color-dark);">
      <div class="container text-center">
        <h2>Not Sure Where to Start?</h2>
        <p style="color: var(--color-gray-light); margin: 1rem 0 1.5rem; max-width: 500px; margin-left: auto; margin-right: auto;">
          Take the free 3-minute assessment. Find out where you are and what to do next.
        </p>
        <a href="/assessment/" class="btn">Take Free Assessment</a>
      </div>
    </section>
  </main>

  <CTABanner />
  <Footer />
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-black), #1a1410);
    padding: 5rem 1.5rem 3rem;
    text-align: center;
    border-bottom: 3px solid var(--color-gold);
  }
  .page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 0.5rem; }
  .page-hero p { color: var(--color-gray-light); font-size: 1.1rem; }

  .schedule-note {
    max-width: 700px;
    margin: 0 auto 3rem;
    text-align: center;
    padding: 1.5rem;
    background: var(--color-dark);
    border-left: 3px solid var(--color-gold);
  }
  .schedule-note p { font-size: 0.9rem; color: var(--color-gray-light); }

  .month-heading {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
    color: var(--color-gold);
  }

  .workshop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .workshop-card {
    background: var(--color-dark);
    border: 1px solid var(--color-gray);
    padding: 1.5rem;
    transition: border-color 0.2s;
  }
  .workshop-card:hover { border-color: var(--color-gold); }

  .card-header {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .level-badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    font-weight: 600;
  }
  .level--beginner { background: #2a5a3a; color: #5ed4b4; }
  .level--intermediate { background: #5a3a2a; color: #d4a853; }
  .level--all-levels { background: #2a3a5a; color: #8b9dc3; }

  .category-badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-light);
  }

  .workshop-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .workshop-card h3 a { color: var(--color-white); }
  .workshop-card h3 a:hover { color: var(--color-gold); }

  .excerpt {
    font-size: 0.82rem;
    color: var(--color-gray-light);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .card-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .detail { display: flex; flex-direction: column; }
  .detail-label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-gray); }
  .detail-value { font-size: 0.8rem; color: var(--color-gray-light); }
  .detail-price { color: var(--color-gold); font-weight: 600; }

  .card-actions { display: flex; gap: 0.5rem; }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
  }

  .schedule-cta { padding: 3rem 0 1rem; }
  .schedule-cta p { color: var(--color-gray-light); margin: 0.75rem 0 1.5rem; }
  .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 600px) {
    .workshop-grid { grid-template-columns: 1fr; }
    .card-details { grid-template-columns: 1fr; }
  }
</style>
